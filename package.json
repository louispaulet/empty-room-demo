{
  "name": "empty-room-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "tsc -p tsconfig.frontend.json --noEmit && vite build",
    "build:backend": "npm run typecheck:backend && npm run worker:check",
    "test": "vitest run",
    "test:frontend": "vitest run src",
    "test:backend": "vitest run worker",
    "typecheck": "tsc -b",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json --noEmit",
    "typecheck:backend": "tsc -p tsconfig.backend.json --noEmit",
    "worker:check": "wrangler deploy --dry-run --config wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config wrangler.jsonc",
    "worker:dev": "wrangler dev --config wrangler.jsonc --ip 127.0.0.1 --port 8787"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.0.0"
  }
}
